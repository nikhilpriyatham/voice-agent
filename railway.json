{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && pip install -r requirements.txt",
    "watchPatterns": [
      "server/**"
    ]
  },
  "deploy": {
    "startCommand": "cd server && python bot.py",
    "restartPolicyType": "ON_FAILURE"
  }
}
{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm ci || npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://voice-agent-production-58c7.up.railway.app/api/$1"
    },
    {
      "source": "/noop",
      "destination": "https://voice-agent-production-58c7.up.railway.app/api/offer"
    }
  ]
}